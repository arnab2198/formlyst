# App
NODE_ENV=development
PORT=8000
APP_NAME=Formlyst
APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=formlyst

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Mail
# MAIL_SECURE=true is for implicit TLS (port 465) only. STARTTLS ports
# (587, 2525, e.g. Mailtrap's sandbox) need MAIL_SECURE=false — nodemailer
# upgrades the connection itself. Getting this backwards fails with a TLS
# handshake error, not an auth error.
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@formlyst.dev

# Telemetry
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Auth
INTERNAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_ABSOLUTE_MAX_SECONDS=7776000
REGISTRATION_TOKEN_TTL_SECONDS=1800
OAUTH_STATE_TTL_SECONDS=600
LINK_INTENT_TTL_SECONDS=300
HANDOFF_CODE_TTL_SECONDS=60
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5